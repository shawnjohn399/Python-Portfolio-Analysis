    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "portfolio = pd.DataFrame({\n",
        "    \"Stock\": [\"MSFT\", \"UNH\", \"AAPL\", \"XOM\", \"AMZN\"],\n",
        "    \"Weight\": [0.6614, 0.2440, 0.0732, 0.0211, 0.0]\n",
        "})\n",
        "\n",
        "# Hypothetical stress scenario\n",
        "portfolio[\"Stress_Return\"] = np.array([\n",
        "    -0.20,  # Microsoft\n",
        "    -0.10,  # UnitedHealth\n",
        "    -0.15,  # Apple\n",
        "    -0.08,  # Exxon\n",
        "    -0.25   # Amazon\n",
        "])\n",
        "\n",
        "# Calculate each stock's contribution\n",
        "portfolio[\"Impact\"] = (\n",
        "    portfolio[\"Weight\"] * portfolio[\"Stress_Return\"]\n",
        ")\n",
        "\n",
        "# Calculate total portfolio impact\n",
        "total_impact = portfolio[\"Impact\"].sum()\n",
        "\n",
        "print(portfolio)\n",
        "print(f\"Total portfolio impact: {total_impact:.2%}\")"
      ],
      "metadata": {
